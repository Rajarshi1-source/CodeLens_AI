# CodeLens AI — full-stack docker-compose environment template.
# Copy to .env and fill in real values (never commit .env):
#   cp .env.example .env
# Variables are consumed by docker-compose.yml. Sensible defaults exist for everything except
# the GitHub OAuth credentials (needed to log in) and OpenAI (only for the real LLM provider).

# --- Datastores ---
POSTGRES_PASSWORD=postgres

# --- Images (leave unset for local build; on a deploy host set to the CI-pushed tags
#     so `docker compose pull` fetches them, e.g. youruser/codelensai-backend:latest) ---
# BACKEND_IMAGE=youruser/codelensai-backend:latest
# FRONTEND_IMAGE=youruser/codelensai-frontend:latest

# --- GitHub OAuth2 app (https://github.com/settings/developers) ---
# Authorization callback URL must be: http://localhost:3000/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub webhook (same secret configured on the repo webhook) ---
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_API_BASE_URL=https://api.github.com

# --- LLM provider (default: local mock, no API key needed) ---
# Set LLM_PROVIDER=gpt5 + OPENAI_API_KEY + a real REVIEW_MODEL to use OpenAI.
LLM_PROVIDER=local
REVIEW_MODEL=local-mock
SUMMARY_MODEL=local-mock
LLM_FALLBACK_PROVIDER=local
LLM_DAILY_TOKEN_BUDGET=2000000
REVIEW_PROMPT_VERSION=v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- At-rest encryption for stored GitHub tokens (use a random 32+ char secret) ---
CODELENS_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-secret-key

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Langfuse (LLM tracing). Off until you create a project in the Langfuse UI (:3002)
#     and paste its keys here, then set CODELENS_LANGFUSE_ENABLED=true. ---
CODELENS_LANGFUSE_ENABLED=false
CODELENS_LANGFUSE_HOST=http://langfuse:3000
CODELENS_LANGFUSE_PUBLIC_KEY=
CODELENS_LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=postgres
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-nextauth-secret
LANGFUSE_SALT=changeme-langfuse-salt
