# CodeLens AI — backend environment template
# Copy to .env and fill in real values (never commit .env):
#   cp .env.example .env
#
# Matches variables in src/main/resources/application.yml.
# Start infrastructure first: docker compose -f compose.yaml up -d

# --- Server ---
SERVER_PORT=8080

# --- PostgreSQL (see compose.yaml) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codelensai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Redis (see compose.yaml) ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- GitHub OAuth2 (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- GitHub webhook (same secret as configured on the repo webhook) ---
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_API_BASE_URL=https://api.github.com

# --- LLM provider (MVP default: local mock, no API key) ---
# Set LLM_PROVIDER=gpt5 and OPENAI_API_KEY=... to use the real OpenAI provider.
LLM_PROVIDER=local
REVIEW_MODEL=local-mock
SUMMARY_MODEL=local-mock
LLM_FALLBACK_PROVIDER=local
LLM_DAILY_TOKEN_BUDGET=2000000
REVIEW_PROMPT_VERSION=v1

# --- OpenAI (only needed when LLM_PROVIDER=gpt5; for gpt5 set REVIEW_MODEL to a real model id) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- At-rest encryption for stored GitHub tokens (use a random 32+ char secret in production) ---
CODELENS_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-secret-key

# --- Langfuse LLM tracing (optional; off by default). Create a project in the Langfuse UI,
#     paste its keys, and set CODELENS_LANGFUSE_ENABLED=true to trace each review. ---
CODELENS_LANGFUSE_ENABLED=false
CODELENS_LANGFUSE_HOST=http://localhost:3000
CODELENS_LANGFUSE_PUBLIC_KEY=
CODELENS_LANGFUSE_SECRET_KEY=
