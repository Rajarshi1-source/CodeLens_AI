# CodeLens AI — backend environment template
# Copy to .env and fill in real values (never commit .env):
#   cp .env.example .env
#
# Matches variables in src/main/resources/application.yml.
# Start infrastructure first: docker compose -f compose.yaml up -d

# --- Server ---
SERVER_PORT=8080

# --- PostgreSQL (see compose.yaml) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codelensai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Redis (see compose.yaml) ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- GitHub OAuth2 (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- GitHub webhook (same secret as configured on the repo webhook) ---
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_API_BASE_URL=https://api.github.com

# --- LLM provider (MVP default: local mock, no API key) ---
LLM_PROVIDER=local
REVIEW_MODEL=local-mock
SUMMARY_MODEL=local-mock
LLM_FALLBACK_PROVIDER=local
LLM_DAILY_TOKEN_BUDGET=2000000
REVIEW_PROMPT_VERSION=v1

# --- At-rest encryption for stored GitHub tokens (use a random 32+ char secret in production) ---
CODELENS_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-secret-key
