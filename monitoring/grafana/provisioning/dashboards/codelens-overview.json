{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "CodeLens AI \u2014 Overview",
  "uid": "codelens-overview",
  "tags": [
    "codelens"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Review latency (avg, seconds)",
      "description": "webhook -> review complete. Target: P50 < 15s, P95 < 30s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(review_duration_seconds_sum[5m]) / clamp_min(rate(review_duration_seconds_count[5m]), 1)",
          "legendFormat": "avg review seconds"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Review queue depth",
      "description": "Pending jobs in the review-jobs Redis Stream. Alert when > 50.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "review_queue_pending_total",
          "legendFormat": "pending jobs"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx error rate",
      "description": "Server errors per second. Keep below 1% of traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM tokens used (per hour)",
      "description": "Proxy for review cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(llm_tokens_total[1h])",
          "legendFormat": "tokens/hour"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Cost & resilience",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM spend (USD per hour)",
      "description": "Sum of ModelPricing x actual usage per review chunk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (increase(llm_cost_usd_total[1h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Token budget left today",
      "description": "Daily budget enforced atomically in Redis; reviews become REVIEW_UNAVAILABLE (BUDGET_EXCEEDED) at 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "llm_budget_remaining_tokens",
          "legendFormat": "remaining"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "llm_budget_limit_tokens",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fallbacks, refusals and shed chunks",
      "description": "Primary provider failures served by the fallback provider, model refusals, and chunks shed by the bulkhead.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (from, to, reason) (increase(llm_fallback_total[1h]))",
          "legendFormat": "fallback {{from}}->{{to}} ({{reason}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_refusals_total[1h]))",
          "legendFormat": "refusals"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_shed_total[1h]))",
          "legendFormat": "shed"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Input vs output tokens (per hour)",
      "description": "Token mix by provider; output tokens dominate cost on most models.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (increase(llm_tokens_input_total[1h]))",
          "legendFormat": "in {{provider}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider) (increase(llm_tokens_output_total[1h]))",
          "legendFormat": "out {{provider}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Reviews by risk band (24h)",
      "description": "G3 risk score distribution of completed reviews.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (risk) (increase(review_completed_total{status=\"completed\"}[24h]))",
          "legendFormat": "{{risk}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Retrieval, feedback & collaboration",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retrieval latency (avg, ms) and snippets",
      "description": "G1 repo-aware context: time to fetch callers/tests/neighbours per chunk, and how many snippets were used.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * rate(retrieval_latency_seconds_sum[5m]) / clamp_min(rate(retrieval_latency_seconds_count[5m]), 1)",
          "legendFormat": "latency ms"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(retrieval_snippets_sum[5m]) / clamp_min(rate(retrieval_snippets_count[5m]), 1)",
          "legendFormat": "snippets / chunk"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Indexing",
      "description": "Chunks written to the pgvector index and average index-job duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(index_chunks_total[1h])",
          "legendFormat": "chunks indexed / h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(index_duration_seconds_sum[1h]) / clamp_min(rate(index_duration_seconds_count[1h]), 1)",
          "legendFormat": "avg job seconds"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Feedback & applied suggestions",
      "description": "Thumbs up/down on AI comments (G7) and suggestions posted to GitHub (G6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (vote) (increase(feedback_votes_total[1h]))",
          "legendFormat": "vote {{vote}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (increase(suggestion_apply_total[1h]))",
          "legendFormat": "apply {{result}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Live viewers and stream replays",
      "description": "G5 presence: viewers across open PR pages; items replayed to reconnecting clients.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(presence_viewers)",
          "legendFormat": "viewers"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(ws_replay_items_total[5m])",
          "legendFormat": "replayed items / 5m"
        }
      ]
    }
  ]
}